{
  "name": "mcp-multi-db",
  "version": "1.0.2",
  "description": "Read-only MCP server for PostgreSQL, MySQL, and SQLite — one server, one config, one set of tools across multiple databases.",
  "license": "ISC",
  "author": "Anuj Mahajan",
  "type": "module",
  "main": "./build/index.js",
  "bin": {
    "mcp-multi-db": "./build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mahAnuj/mcp-multi-db.git"
  },
  "homepage": "https://github.com/mahAnuj/mcp-multi-db#readme",
  "bugs": {
    "url": "https://github.com/mahAnuj/mcp-multi-db/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "llm-tools",
    "ai-agents",
    "database",
    "postgres",
    "postgresql",
    "mysql",
    "sqlite",
    "sql",
    "read-only",
    "schema-introspection"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && chmod 755 build/index.js",
    "test": "npm run build && node --test \"test/**/*.test.ts\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.10.0",
    "mysql2": "^3.22.4",
    "pg": "^8.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "typescript": "^6.0.3"
  }
}
